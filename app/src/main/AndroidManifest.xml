<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Bluetooth runtime permissions for Android 12+ (API 31+).
        The `neverForLocation` flag is mandatory on API 31+ when the app does
        NOT derive physical location from BLE beacons. BlueWave only performs
        classic RFCOMM messaging, so this flag is always safe to declare.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="31" />

    <!--
        minSdk = 31, so the legacy `BLUETOOTH` / `BLUETOOTH_ADMIN` /
        `ACCESS_FINE_LOCATION` triplet that was required for discovery
        on API 30 and below is intentionally NOT declared. The runtime
        Bluetooth permissions above already cover the full API surface
        BlueWave touches.
    -->

    <!--
        Foreground service plumbing — without these the accept-loop in
        BluetoothSessionManager dies the moment Android reclaims the
        process. `connectedDevice` is the correct FGS type for a
        peer-to-peer BT messenger and ships with its own dedicated
        runtime permission on API 34+ (`FOREGROUND_SERVICE_CONNECTED_DEVICE`).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />

    <!--
        Android 13+ runtime permission required to show the persistent
        "BlueWave is listening" notification that anchors the foreground
        service. Denying this permission does NOT stop the FGS — Android
        keeps the service alive, the user just doesn't see the
        notification. The app gracefully degrades in that case.
    -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />

    <!-- Hardware feature declaration for Bluetooth. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <application
        android:name=".BlueWaveApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bluewavemobile">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Bluewavemobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Foreground service that keeps the RFCOMM accept-loop alive
            in the background. `foregroundServiceType` must match the
            value passed to ServiceCompat.startForeground at runtime
            (Android 14+ rejects any mismatch with a SecurityException).
            `exported=false` because the service is internal — no other
            process should be able to start it.
        -->
        <service
            android:name=".network.BlueWaveBluetoothService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />

        <!--
            Exposes the staged BlueWave APK to the system Bluetooth
            share activity so `ApkSender.suggestInstall` can hand the
            installer over via Object Push Profile. Only files inside
            the cache dir are exposed (see res/xml/file_paths.xml).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
