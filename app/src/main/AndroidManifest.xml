<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
        Bluetooth runtime permissions for Android 12+ (API 31+).
        The `neverForLocation` flag is mandatory on API 31+ when the app does
        NOT derive physical location from BLE beacons. BlueWave only performs
        classic RFCOMM messaging, so this flag is always safe to declare.
    -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="31" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="31" />

    <!--
        minSdk = 31, so the legacy `BLUETOOTH` / `BLUETOOTH_ADMIN` /
        `ACCESS_FINE_LOCATION` triplet that was required for discovery
        on API 30 and below is intentionally NOT declared. The runtime
        Bluetooth permissions above already cover the full API surface
        BlueWave touches.
    -->

    <!-- Hardware feature declaration for Bluetooth. -->
    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="true" />

    <application
        android:name=".BlueWaveApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Bluewavemobile">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:theme="@style/Theme.Bluewavemobile">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            Exposes the staged BlueWave APK to the system Bluetooth
            share activity so `ApkSender.suggestInstall` can hand the
            installer over via Object Push Profile. Only files inside
            the cache dir are exposed (see res/xml/file_paths.xml).
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>
