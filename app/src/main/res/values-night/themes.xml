<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Night-mode variant of the framework-only base theme. The actual
      colour palette is provided by the Compose `BlueWaveTheme`'s
      dark colour scheme; this XML only flips the status bar
      treatment so the system icons are drawn light-on-dark before
      Compose has had a chance to apply its own surface tint.
    -->
    <style name="Theme.Bluewavemobile" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
    </style>
</resources>
