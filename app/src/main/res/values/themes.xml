<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      Plain framework theme. The app is fully Jetpack Compose, so all
      Material Design 3 surfaces, colour schemes and typography are
      driven from `BlueWaveTheme` in Kotlin. The XML theme only needs
      to cover what the system reads before Compose takes over: a
      transparent status bar that lets `enableEdgeToEdge()` handle
      the inset drawing, and a "no action bar" parent so MainActivity
      can render its own Compose `TopAppBar`s.
    -->
    <style name="Theme.Bluewavemobile" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>
</resources>
